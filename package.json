{
  "name": "fullstack-typescript-iot",
  "description": "A fullstack TypeScript IoT application",
  "license": "MIT",
  "private": true,
  "version": "0.0.0",
  "author": "Sergii Sokurenko",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:server": "bun run --filter @iot/server dev",
    "dev:client": "bun run --filter @iot/client dev",
    "dev:mock": "bun run --filter @iot/mock-device dev",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '*' build",
    "e2e": "bun run --filter @iot/e2e test",
    "e2e:ui": "bun run --filter @iot/e2e test:ui",
    "test:client": "bun run --filter @iot/client test",
    "test:server": "bun run --filter @iot/server test",
    "test": "bun run test:client && bun run test:server",
    "check": "bun lint && bun typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0"
  }
}
