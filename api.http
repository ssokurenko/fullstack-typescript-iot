@baseUrl = http://localhost:4000

### Fetch greenhouse readings (GraphQL)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query Readings($limit: Int) { readings(limit: $limit) { id temp humidity soilMoisture co2 timestamp } }",
  "variables": { "limit": 10 }
}

### Add a reading via GraphQL mutation
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation AddReading($temp: Float!, $humidity: Float!, $soilMoisture: Float!, $co2: Float!) { addReading(temp: $temp, humidity: $humidity, soilMoisture: $soilMoisture, co2: $co2) { id temp humidity soilMoisture co2 timestamp } }",
  "variables": { "temp": 22.8, "humidity": 58, "soilMoisture": 41.2, "co2": 812 }
}

### Post a reading from an external device (REST ingest endpoint)
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "temp": 23.6,
  "humidity": 55,
  "soilMoisture": 38.4,
  "co2": 798
}

### Post another reading from an external device
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "temp": 24.1,
  "humidity": 52,
  "soilMoisture": 36.9,
  "co2": 820
}

### Invalid device payload (should 400)
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "temp": "not-a-number",
  "humidity": 55,
  "soilMoisture": 38.4,
  "co2": 798
}
