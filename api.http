@baseUrl = http://localhost:4000

### Fetch greenhouse readings (GraphQL)
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "query Readings($limit: Int) { readings(limit: $limit) { id metric value unit timestamp } }",
  "variables": { "limit": 10 }
}

### Add a reading via GraphQL mutation
POST {{baseUrl}}/graphql
Content-Type: application/json

{
  "query": "mutation AddReading($metric: String!, $value: Float!, $unit: String) { addReading(metric: $metric, value: $value, unit: $unit) { id metric value unit timestamp } }",
  "variables": { "metric": "temperature", "value": 22.8, "unit": "celsius" }
}

### Post a temperature reading from an external device (REST ingest endpoint)
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "metric": "temperature",
  "value": 32.6,
  "unit": "celsius"
}

### Post a humidity reading from an external device
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "metric": "humidity",
  "value": 58,
  "unit": "percent"
}

### Post a soil moisture reading from an external device
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "metric": "soilMoisture",
  "value": 41.2,
  "unit": "percent"
}

### Post a CO2 reading from an external device
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "metric": "co2",
  "value": 812,
  "unit": "ppm"
}

### Invalid device payload (should 400)
POST {{baseUrl}}/readings
Content-Type: application/json

{
  "metric": "",
  "value": "not-a-number"
}
